# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env
.codex

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bun
.bun/
.bun-build
bun.lock*

# docs/ used to be ignored when it held generated reports. Now it
# holds first-class docs (architecture, differential testing, feature
# matrix, migration guide) — we WANT them tracked. Re-ignored entries
# below for the few files that should stay local-only.
# docs/  <-- left for reference; un-ignored 2026-04-30
docs/.cache/
api/generated-outputs
api/.anvil-data
.anvil-data/
codex-session.jsonl
claude-session.jsonl
AGENTIC-GRANT-APPLICATION.md
.claude/
api/scratch-*.ts
video.md
posts/
test-ledger/
# CI workflow held back from commit until ready to enable — would burn
# free-tier minutes prematurely. Drafted in the working tree at
# .github/workflows/test.yml; staging it commits the workflow.
.github/
# Snapshot test failure leftovers — regenerated on mismatch, byte-identical
# to .snap.rs once the snapshot updates, otherwise stale-but-harmless.
api/tests/snapshots/emitter-output/*.actual.rs
api/tests/snapshots/binary-parity/*.snap.actual
# anvil-sol prepack output (regenerated on each npm publish)
cli/src/
# Real-world cargo coverage fetches public Anchor sources on first run
# into this dir (offline-repeatable after that). The test file holds the
# pointer + sha; committing the source verbatim would mirror upstream.
api/tests/fixtures/realworld/

# CLI differential/compile build output
anvil-output/
