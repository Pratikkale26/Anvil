# Production env for `next build` — picked up automatically by Next.js
# when NODE_ENV=production (Vercel deploys, `next build`, `next start`).
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# This is a public URL (already in README), safe to commit.
#
# Local dev uses .env (gitignored) which defaults to http://localhost:8080.
NEXT_PUBLIC_API_URL=https://anvil-app-nrjdl.ondigitalocean.app
