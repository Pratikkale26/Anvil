=== errors.rs ===
//! Error definitions for ReturnErr

use super::*;

#[derive(Clone, Copy, Debug, PartialEq)]
#[repr(u32)]
pub enum DemoError {
    /// Zero is not allowed
    ZeroNotAllowed = 6000,
}

pub use DemoError::*;

impl From<DemoError> for ProgramError {
    fn from(error: DemoError) -> Self {
        ProgramError::Custom(error as u32)
    }
}

impl std::fmt::Display for DemoError {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        write!(f, "{:?}", self)
    }
}

impl std::error::Error for DemoError {}

=== helpers.rs ===
//! Helper functions for ReturnErr

use super::*;
use crate::state::*;
use crate::errors::*;

pub fn create_program_account<'a>(
    account: &AccountInfo<'a>,
    payer: &AccountInfo<'a>,
    space: u64,
    program_id: &Pubkey,
    signer_seeds: &[&[&[u8]]],
) -> ProgramResult {
    let rent = solana_program::sysvar::rent::Rent::get()?;
    let lamports = rent.minimum_balance(space as usize);
    let create_ix = system_instruction::create_account(
        payer.key,
        account.key,
        lamports,
        space,
        program_id,
    );
    invoke_signed(
        &create_ix,
        &[payer.clone(), account.clone()],
        signer_seeds,
    )?;
    Ok(())
}

=== instructions/always_fails.rs ===
use super::*;
use crate::errors::*;

pub fn always_fails(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let state = &accounts[0];
    let authority = &accounts[1];
    let _system_program = &accounts[2];

    if !authority.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !state.is_writable || !authority.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }

    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let (expected_key, bump_state) = Pubkey::find_program_address(&[b"return-err", authority.key.as_ref()], program_id);
    if expected_key != *state.key {
        return Err(ProgramError::InvalidSeeds);
    }
    // init_if_needed: only allocate when the account is empty.
    if state.data_is_empty() {
        let init_state_seeds: &[&[u8]] = &[
                b"return-err",
                authority.key.as_ref(),
                &[bump_state],
            ];
        let init_state_signer_seeds = &[&init_state_seeds[..]];
        create_program_account(state, authority, (8 + StateAccount::INIT_SPACE) as u64, program_id, init_state_signer_seeds)?;
        {
            let mut __init_data = state.data.borrow_mut();
            __init_data[..8].copy_from_slice(&StateAccount::DISCRIMINATOR);
        }
    }
    return Err(DemoError::ZeroNotAllowed.into());

    Ok(())
}

