//! Error definitions for ReturnErr

use super::*;

#[derive(Clone, Copy, Debug, PartialEq)]
#[repr(u32)]
pub enum DemoError {
    /// Zero is not allowed
    ZeroNotAllowed = 6000,
}

pub use DemoError::*;

impl From<DemoError> for ProgramError {
    fn from(error: DemoError) -> Self {
        ProgramError::Custom(error as u32)
    }
}

=== helpers.rs ===
//! Helper functions for ReturnErr

use super::*;
use crate::state::*;
use crate::errors::*;

pub fn bump_seed(
    program_id: &Pubkey,
    seeds: &[&[u8]],
    expected: &Pubkey,
) -> Result<u8, ProgramError> {
    for bump in (0..=255u8).rev() {
        let mut seeds_with_bump: [&[u8]; 16] = [&[]; 16];
        let len = seeds.len().min(15);
        seeds_with_bump[..len].copy_from_slice(&seeds[..len]);
        let bump_slice = &[bump];
        seeds_with_bump[len] = bump_slice;
        if let Ok(derived) = pinocchio::pubkey::create_program_address(&seeds_with_bump[..len + 1], program_id) {
            if &derived == expected {
                return Ok(bump);
            }
        }
    }
    Err(ProgramError::InvalidSeeds)
}

pub fn create_program_account(
    account: &AccountInfo,
    payer: &AccountInfo,
    space: usize,
    program_id: &Pubkey,
    signer_seeds: &[&[&[u8]]],
) -> ProgramResult {
    if signer_seeds.len() > 1 {
        return Err(ProgramError::InvalidSeeds);
    }

    let signer_storage = signer_seeds.first().map(|seed_group| {
        let mut seeds: [Seed<'_>; 8] = core::array::from_fn(|_| Seed::from(&[][..]));
        for (index, seed) in seed_group.iter().enumerate() {
            if index >= seeds.len() {
                return Err(ProgramError::InvalidSeeds);
            }
            seeds[index] = Seed::from(*seed);
        }
        Ok((seeds, seed_group.len()))
    }).transpose()?;

    let signer_slice = if let Some((ref seeds, len)) = signer_storage {
        let signer = Signer::from(&seeds[..len]);
        create_account_with_minimum_balance_signed(account, space, program_id, payer, None, &[signer])
    } else {
        create_account_with_minimum_balance_signed(account, space, program_id, payer, None, &[])
    };

    signer_slice
}

=== instructions/always_fails.rs ===
use super::*;
use crate::errors::*;

pub fn always_fails(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let state = &accounts[0];
    let authority = &accounts[1];
    let _system_program = &accounts[2];

    if !authority.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !state.is_writable() || !authority.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }

    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let bump_state = bump_seed(program_id, &[b"return-err", authority.key().as_ref()], state.key())?;
    // init_if_needed: only allocate when the account is empty.
    if state.data_is_empty() {
        let init_state_seeds: &[&[u8]] = &[
                b"return-err",
                authority.key().as_ref(),
                &[bump_state],
            ];
        let init_state_signer_seeds = &[&init_state_seeds[..]];
        create_program_account(state, authority, (8 + StateAccount::INIT_SPACE) as usize, program_id, init_state_signer_seeds)?;
        {
            let mut __init_data = unsafe { state.borrow_mut_data_unchecked() };
            __init_data[..8].copy_from_slice(&StateAccount::DISCRIMINATOR);
        }
    }
    return Err(DemoError::ZeroNotAllowed.into());

    Ok(())
}

