=== helpers.rs ===
//! Helper functions for ReallocGrowDemo

use super::*;
use crate::state::*;

pub fn create_program_account<'a>(
    account: &AccountInfo<'a>,
    payer: &AccountInfo<'a>,
    space: u64,
    program_id: &Pubkey,
    signer_seeds: &[&[&[u8]]],
) -> ProgramResult {
    let rent = solana_program::sysvar::rent::Rent::get()?;
    let lamports = rent.minimum_balance(space as usize);
    let create_ix = system_instruction::create_account(
        payer.key,
        account.key,
        lamports,
        space,
        program_id,
    );
    invoke_signed(
        &create_ix,
        &[payer.clone(), account.clone()],
        signer_seeds,
    )?;
    Ok(())
}

=== instructions/append_four.rs ===
use super::*;

pub fn append_four(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let state = &accounts[0];
    let owner = &accounts[1];
    let _system_program = &accounts[2];

    if !owner.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !state.is_writable || !owner.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }
    if state.owner != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining = data;
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let b0: u8 = arg_bytes[0];
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let b1: u8 = arg_bytes[0];
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let b2: u8 = arg_bytes[0];
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let b3: u8 = arg_bytes[0];
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    // realloc — resize state to 8 + 1 + 4 + state.log.len() + 4
    {
        let __state_for_realloc = GrowState::from_account_info(state)?;
        let __new_size = (8 + 1 + 4 + __state_for_realloc.log.len() + 4) as usize;
        let __rent = solana_program::sysvar::rent::Rent::get()?;
        let __new_lamports = __rent.minimum_balance(__new_size);
        let __delta = __new_lamports.saturating_sub(state.lamports());
        if __delta > 0 {
            let __ix = solana_program::system_instruction::transfer(
                owner.key,
                state.key,
                __delta,
            );
            solana_program::program::invoke(
                &__ix,
                &[owner.clone(), state.clone()],
            )?;
        }
        state.realloc(__new_size, false)?;
    }
    let (expected_key, _bump_state) = Pubkey::find_program_address(&[b"realloc-grow", owner.key.as_ref()], program_id);
    if expected_key != *state.key {
        return Err(ProgramError::InvalidSeeds);
    }
    let mut s = GrowState::read(&state.data.borrow())?;
    s.log.push(b0);
    s.log.push(b1);
    s.log.push(b2);
    s.log.push(b3);
    GrowState::write(&mut state.data.borrow_mut(), &s)?;
    Ok(())

}

