pub use shut::shut;


=== instructions/open.rs ===
use super::*;

pub fn open(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let note = &accounts[0];
    let owner = &accounts[1];
    let _system_program = &accounts[2];

    if !owner.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !note.is_writable() || !owner.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }

    // Args
    let mut remaining = data;
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let value: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let bump_note = bump_seed(program_id, &[b"note", owner.key().as_ref()], note.key())?;
    let init_note_seeds: &[&[u8]] = &[
            b"note",
            owner.key().as_ref(),
            &[bump_note],
        ];
    let init_note_signer_seeds = &[&init_note_seeds[..]];
    create_program_account(note, owner, (8 + 32 + 8) as usize, program_id, init_note_signer_seeds)?;
    {
        let mut __init_data = unsafe { note.borrow_mut_data_unchecked() };
        __init_data[..8].copy_from_slice(&Note::DISCRIMINATOR);
    }
    let note_account = note;
    let mut note = Note {
        owner: [0u8; 32],
        value: 0,
    };
    note.owner = *owner.key();
    note.value = value;
    Note::save(note_account, &note)?;
    Ok(())

}

=== instructions/shut.rs ===
use super::*;

pub fn shut(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let note = &accounts[0];
    let receiver = &accounts[1];
    let owner = &accounts[2];

    if !owner.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !note.is_writable() || !receiver.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }
    if note.owner() != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let _bump_note = bump_seed(program_id, &[b"note", owner.key().as_ref()], note.key())?;
    let __ha_note = Note::from_account_info(note)?;
    if __ha_note.owner != *owner.key() {
        return Err(ProgramError::InvalidAccountData);
    }
    close_program_account(note, receiver)?;
    Ok(())

}

