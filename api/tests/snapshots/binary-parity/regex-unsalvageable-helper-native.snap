use super::*;

pub fn do_xfer(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 5 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;

    let from = &accounts[0];
    let to = &accounts[1];
    let mint = &accounts[2];
    let authority = &accounts[3];
    let token_program = &accounts[4];

    if !authority.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !from.is_writable || !to.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }
    if *from.owner != Pubkey::new_from_array([6, 221, 246, 225, 215, 101, 161, 147, 217, 203, 225, 70, 206, 235, 121, 172, 28, 180, 133, 237, 95, 91, 55, 145, 58, 140, 245, 133, 126, 255, 0, 169]) && *from.owner != Pubkey::new_from_array([6, 221, 246, 225, 238, 117, 143, 222, 24, 66, 93, 188, 228, 108, 205, 218, 182, 26, 252, 77, 131, 185, 13, 39, 254, 189, 249, 40, 216, 161, 139, 252]) {
        return Err(ProgramError::IncorrectProgramId);
    }
    if *to.owner != Pubkey::new_from_array([6, 221, 246, 225, 215, 101, 161, 147, 217, 203, 225, 70, 206, 235, 121, 172, 28, 180, 133, 237, 95, 91, 55, 145, 58, 140, 245, 133, 126, 255, 0, 169]) && *to.owner != Pubkey::new_from_array([6, 221, 246, 225, 238, 117, 143, 222, 24, 66, 93, 188, 228, 108, 205, 218, 182, 26, 252, 77, 131, 185, 13, 39, 254, 189, 249, 40, 216, 161, 139, 252]) {
        return Err(ProgramError::IncorrectProgramId);
    }
    if *mint.owner != Pubkey::new_from_array([6, 221, 246, 225, 215, 101, 161, 147, 217, 203, 225, 70, 206, 235, 121, 172, 28, 180, 133, 237, 95, 91, 55, 145, 58, 140, 245, 133, 126, 255, 0, 169]) && *mint.owner != Pubkey::new_from_array([6, 221, 246, 225, 238, 117, 143, 222, 24, 66, 93, 188, 228, 108, 205, 218, 182, 26, 252, 77, 131, 185, 13, 39, 254, 189, 249, 40, 216, 161, 139, 252]) {
        return Err(ProgramError::IncorrectProgramId);
    }
    if *token_program.key != Pubkey::new_from_array([6, 221, 246, 225, 215, 101, 161, 147, 217, 203, 225, 70, 206, 235, 121, 172, 28, 180, 133, 237, 95, 91, 55, 145, 58, 140, 245, 133, 126, 255, 0, 169]) && *token_program.key != Pubkey::new_from_array([6, 221, 246, 225, 238, 117, 143, 222, 24, 66, 93, 188, 228, 108, 205, 218, 182, 26, 252, 77, 131, 185, 13, 39, 254, 189, 249, 40, 216, 161, 139, 252]) {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining: &[u8] = __ix_data;
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let amount: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
// ⚠️ Anvil TODO: call site of unsalvageable helper commented out — manual port required
//     if !remaining.is_empty() {
//         return Err(ProgramError::InvalidInstructionData);
//     }
// 
//     transfer_via_helper(
//             &from,
//             &to,
//             &mint,
//             &authority,
//             &token_program,
//             amount,
//         )?;
    Ok(())

}

