=== helpers.rs ===
//! Helper functions for ReallocDemo

use super::*;
use crate::state::*;

pub fn create_program_account<'a>(
    account: &AccountInfo<'a>,
    payer: &AccountInfo<'a>,
    space: u64,
    program_id: &Pubkey,
    signer_seeds: &[&[&[u8]]],
) -> ProgramResult {
    let rent = solana_program::sysvar::rent::Rent::get()?;
    let lamports = rent.minimum_balance(space as usize);
    let create_ix = system_instruction::create_account(
        payer.key,
        account.key,
        lamports,
        space,
        program_id,
    );
    invoke_signed(
        &create_ix,
        &[payer.clone(), account.clone()],
        signer_seeds,
    )?;
    Ok(())
}

=== instructions/append.rs ===
use super::*;
use solana_program::program::invoke;

pub fn append(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;

    let state = &accounts[0];
    let owner = &accounts[1];
    let _system_program = &accounts[2];

    if !owner.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !state.is_writable || !owner.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }
    if state.owner != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining: &[u8] = __ix_data;
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let byte: u8 = arg_bytes[0];
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    // realloc — resize state to 8 + 1 + 4 + state.log.len() + 1 (zero=false)
    {
        let __state_for_realloc = LogState::from_account_info(state)?;
        let __new_size = (8 + 1 + 4 + __state_for_realloc.log.len() + 1) as usize;
        let __cur_size = state.data_len();
        // Anchor branches on the BYTE-length delta, NOT the lamports delta
        // (anchor-syn constraints.rs): a GROW only tops up rent and never
        // refunds, so an over-funded account keeps its excess; a SHRINK
        // refunds the freed rent down to the new rent-minimum; an equal-size
        // realloc is a no-op. Branching on the lamports delta silently drains
        // an over-funded account on grow.
        if __new_size != __cur_size {
            let __rent = solana_program::sysvar::rent::Rent::get()?;
            let __new_rent_minimum = __rent.minimum_balance(__new_size);
            let __cur_lamports = state.lamports();
            if __new_size > __cur_size {
                if __new_rent_minimum > __cur_lamports {
                    let __delta = __new_rent_minimum - __cur_lamports;
                    let __ix = solana_program::system_instruction::transfer(
                        owner.key,
                        state.key,
                        __delta,
                    );
                    solana_program::program::invoke(
                        &__ix,
                        &[owner.clone(), state.clone()],
                    )?;
                }
            } else {
                let __refund = __cur_lamports - __new_rent_minimum;
                **state.lamports.borrow_mut() = __cur_lamports - __refund;
                **owner.lamports.borrow_mut() = owner.lamports() + __refund;
            }
            state.realloc(__new_size, false)?;
        }
    }
    let (expected_key, _bump_state) = Pubkey::find_program_address(&[b"realloc-st", owner.key.as_ref()], program_id);
    if expected_key != *state.key {
        return Err(ProgramError::InvalidSeeds);
    }
    let mut s = LogState::read(&state.data.borrow())?;
    s.log.push(byte);
    LogState::write(&mut state.data.borrow_mut(), &s)?;
    Ok(())

}

=== instructions/init.rs ===
use super::*;

pub fn init(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;

    let state = &accounts[0];
    let owner = &accounts[1];
    let _system_program = &accounts[2];

    if !owner.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !state.is_writable || !owner.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }

    if !__ix_data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let (expected_key, bump_state) = Pubkey::find_program_address(&[b"realloc-st", owner.key.as_ref()], program_id);
    if expected_key != *state.key {
        return Err(ProgramError::InvalidSeeds);
    }
    let init_state_seeds: &[&[u8]] = &[
            b"realloc-st",
            owner.key.as_ref(),
            &[bump_state],
        ];
    let init_state_signer_seeds = &[&init_state_seeds[..]];
    create_program_account(state, owner, (8 + 1 + 4) as u64, program_id, init_state_signer_seeds)?;
    {
        let mut __init_data = state.data.borrow_mut();
        __init_data[..8].copy_from_slice(&LogState::DISCRIMINATOR);
    }
    let mut s = LogState { bump: 0, log: Vec::new() };
    s.bump = bump_state;
    s.log = vec![];
    LogState::write(&mut state.data.borrow_mut(), &s)?;
    Ok(())

}

