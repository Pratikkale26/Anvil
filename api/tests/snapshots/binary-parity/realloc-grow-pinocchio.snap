//! State account definitions for ReallocGrowDemo

//! Generated by Anvil v0.3.0 — Target: Pinocchio


use super::*;

#[repr(C)]
pub struct GrowState {
    pub bump: u8,
    pub log: Vec<u8>,
}

impl GrowState {
    pub const DISCRIMINATOR: [u8; 8] = [123, 93, 213, 73, 84, 152, 37, 85];
    pub const INIT_SPACE: usize = 5;
    pub const LEN: usize = 5;
    pub const TOTAL_LEN: usize = 8 + Self::LEN;
    pub const SPACE: usize = Self::TOTAL_LEN;
    pub const SIZE: usize = Self::TOTAL_LEN;
    /// Minimum data length for variable-length structs — discriminator +
    /// each variable field's 4-byte length prefix + each fixed field's
    /// full size. read/write guards check against this instead of
    /// TOTAL_LEN so Anchor sources using `required_space(input.len())`
    /// allocations don't trip InvalidAccountData on init.
    pub const MIN_LEN: usize = 13;

    pub fn read(data: &[u8]) -> Result<Self, ProgramError> {
        if data.len() < Self::MIN_LEN {
            return Err(ProgramError::InvalidAccountData);
        }
        if data[..8] != Self::DISCRIMINATOR {
            return Err(ProgramError::InvalidAccountData);
        }
        // Alias to dodge field-name shadowing — a field named `data` would
        // shadow the parameter and break subsequent field reads.
        let __data_buf: &[u8] = data;
        let mut offset = 8usize;
        let bump: u8 = __data_buf[offset];
        offset += 1;
        let mut log_bytes: &[u8] = &__data_buf[offset..];
        let __log_before = log_bytes.len();
        let log: Vec<u8> = BorshDeserialize::deserialize(&mut log_bytes)
            .map_err(|_| ProgramError::InvalidAccountData)?;
        offset += __log_before - log_bytes.len();
        Ok(Self { bump, log })
    }

    pub fn write(data: &mut [u8], value: &Self) -> ProgramResult {
        if data.len() < Self::MIN_LEN {
            return Err(ProgramError::InvalidAccountData);
        }
        data[..8].copy_from_slice(&Self::DISCRIMINATOR);
        let __data_buf: &mut [u8] = data;
        let mut offset = 8usize;
        __data_buf[offset] = value.bump as u8;
        offset += 1;
        let __log_serialized = ::borsh::to_vec(&value.log)
            .map_err(|_| ProgramError::InvalidAccountData)?;
        __data_buf[offset..offset + __log_serialized.len()].copy_from_slice(&__log_serialized);
        offset += __log_serialized.len();
        Ok(())
    }

    pub fn from_account_info(account: &AccountInfo) -> Result<Self, ProgramError> {
        let data = unsafe { account.borrow_data_unchecked() };
        Self::read(&data)
    }

    pub fn save(account: &AccountInfo, value: &Self) -> ProgramResult {
        let mut data = unsafe { account.borrow_mut_data_unchecked() };
        Self::write(&mut data, value)
    }
}