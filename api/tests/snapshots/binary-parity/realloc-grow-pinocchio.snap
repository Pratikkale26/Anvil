use super::*;

pub fn append_one(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let state = &accounts[0];
    let owner = &accounts[1];
    let _system_program = &accounts[2];

    if !owner.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !state.is_writable() || !owner.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }
    if state.owner() != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining = data;
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let byte: u8 = arg_bytes[0];
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    // realloc — resize state to 8 + 1 + 4 + state.log.len() + 1 (zero=true)
    {
        let __state_for_realloc = GrowState::from_account_info(state)?;
        let __new_size = (8 + 1 + 4 + __state_for_realloc.log.len() + 1) as usize;
        let __rent = pinocchio::sysvars::rent::Rent::get()?;
        let __new_lamports = Rent::get()?.minimum_balance(__new_size);
        let __cur_lamports = state.lamports();
        if __new_lamports > __cur_lamports {
            let __delta = __new_lamports - __cur_lamports;
            pinocchio_system::instructions::Transfer {
                from: owner,
                to: state,
                lamports: __delta,
            }.invoke()?;
        } else if __new_lamports < __cur_lamports {
            let __refund = __cur_lamports - __new_lamports;
            *state.try_borrow_mut_lamports()? = __cur_lamports - __refund;
            *owner.try_borrow_mut_lamports()? = owner.lamports() + __refund;
        }
        state.realloc(__new_size, true)?;
    }
    let _bump_state = bump_seed(program_id, &[b"realloc-grow", owner.key().as_ref()], state.key())?;
    let mut s = GrowState::from_account_info(state)?;
    s.log.push(byte);
    GrowState::save(state, &s)?;
    Ok(())

}

