=== helpers.rs ===
//! Helper functions for ReallocGrowDemo

use super::*;
use crate::state::*;

pub fn bump_seed(
    program_id: &Pubkey,
    seeds: &[&[u8]],
    expected: &Pubkey,
) -> Result<u8, ProgramError> {
    for bump in (0..=255u8).rev() {
        let mut seeds_with_bump: [&[u8]; 16] = [&[]; 16];
        let len = seeds.len().min(15);
        seeds_with_bump[..len].copy_from_slice(&seeds[..len]);
        let bump_slice = &[bump];
        seeds_with_bump[len] = bump_slice;
        if let Ok(derived) = pinocchio::pubkey::create_program_address(&seeds_with_bump[..len + 1], program_id) {
            if &derived == expected {
                return Ok(bump);
            }
        }
    }
    Err(ProgramError::InvalidSeeds)
}

pub fn create_program_account(
    account: &AccountInfo,
    payer: &AccountInfo,
    space: usize,
    program_id: &Pubkey,
    signer_seeds: &[&[&[u8]]],
) -> ProgramResult {
    if signer_seeds.len() > 1 {
        return Err(ProgramError::InvalidSeeds);
    }

    let signer_storage = signer_seeds.first().map(|seed_group| {
        let mut seeds: [Seed<'_>; 8] = core::array::from_fn(|_| Seed::from(&[][..]));
        for (index, seed) in seed_group.iter().enumerate() {
            if index >= seeds.len() {
                return Err(ProgramError::InvalidSeeds);
            }
            seeds[index] = Seed::from(*seed);
        }
        Ok((seeds, seed_group.len()))
    }).transpose()?;

    let signer_slice = if let Some((ref seeds, len)) = signer_storage {
        let signer = Signer::from(&seeds[..len]);
        create_account_with_minimum_balance_signed(account, space, program_id, payer, None, &[signer])
    } else {
        create_account_with_minimum_balance_signed(account, space, program_id, payer, None, &[])
    };

    signer_slice
}

=== instructions/append_four.rs ===
use super::*;

pub fn append_four(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let state = &accounts[0];
    let owner = &accounts[1];
    let _system_program = &accounts[2];

    if !owner.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !state.is_writable() || !owner.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }
    if state.owner() != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining = data;
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let b0: u8 = arg_bytes[0];
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let b1: u8 = arg_bytes[0];
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let b2: u8 = arg_bytes[0];
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let b3: u8 = arg_bytes[0];
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    // realloc — resize state to 8 + 1 + 4 + state.log.len() + 4 (zero=true)
    {
        let __state_for_realloc = GrowState::from_account_info(state)?;
        let __new_size = (8 + 1 + 4 + __state_for_realloc.log.len() + 4) as usize;
        let __rent = pinocchio::sysvars::rent::Rent::get()?;
        let __new_lamports = Rent::get()?.minimum_balance(__new_size);
        let __cur_lamports = state.lamports();
        if __new_lamports > __cur_lamports {
            let __delta = __new_lamports - __cur_lamports;
            pinocchio_system::instructions::Transfer {
                from: owner,
                to: state,
                lamports: __delta,
            }.invoke()?;
        } else if __new_lamports < __cur_lamports {
            let __refund = __cur_lamports - __new_lamports;
            *state.try_borrow_mut_lamports()? = __cur_lamports - __refund;
            *owner.try_borrow_mut_lamports()? = owner.lamports() + __refund;
        }
        state.realloc(__new_size, true)?;
    }
    let _bump_state = bump_seed(program_id, &[b"realloc-grow", owner.key().as_ref()], state.key())?;
    let mut s = GrowState::from_account_info(state)?;
    s.log.push(b0);
    s.log.push(b1);
    s.log.push(b2);
    s.log.push(b3);
    GrowState::save(state, &s)?;
    Ok(())

}

