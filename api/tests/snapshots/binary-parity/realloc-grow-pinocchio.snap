=== instructions/init.rs ===
use super::*;

pub fn init(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let state = &accounts[0];
    let owner = &accounts[1];
    let _system_program = &accounts[2];

    if !owner.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !state.is_writable() || !owner.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }

    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let bump_state = bump_seed(program_id, &[b"realloc-grow", owner.key().as_ref()], state.key())?;
    let init_state_seeds: &[&[u8]] = &[
            b"realloc-grow",
            owner.key().as_ref(),
            &[bump_state],
        ];
    let init_state_signer_seeds = &[&init_state_seeds[..]];
    create_program_account(state, owner, (8 + 1 + 4) as usize, program_id, init_state_signer_seeds)?;
    {
        let mut __init_data = unsafe { state.borrow_mut_data_unchecked() };
        __init_data[..8].copy_from_slice(&GrowState::DISCRIMINATOR);
    }
    let mut s = GrowState { bump: 0, log: Vec::new() };
    s.bump = bump_state;
    s.log = vec![];
    GrowState::save(state, &s)?;
    Ok(())

}

