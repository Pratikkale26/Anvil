=== instructions/set_authority.rs ===
use super::*;
use crate::errors::*;

pub fn set_authority(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 2 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let config = &accounts[0];
    let authority = &accounts[1];

    if !authority.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if config.owner() != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining = data;
    if remaining.len() < 32 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(32);
    remaining = rest;
    let new_authority: [u8; 32] = arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?;
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let _bump_config = bump_seed(program_id, &[b"program-config"], config.key())?;
    if !(new_authority != Pubkey::default()) {
        return Err(ConfigError::InvalidAuthority.into());
    }
    let config_account = config;
    let mut config = ProgramConfig::from_account_info(config_account)?;
    if config.authority != *authority.key() {
        return Err(ProgramError::InvalidAccountData);
    }
    config.authority = new_authority;
    ProgramConfig::save(config_account, &config)?;
    Ok(())

}

=== instructions/set_creation_fee.rs ===
use super::*;
use crate::errors::*;

pub fn set_creation_fee(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 2 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let config = &accounts[0];
    let authority = &accounts[1];

    if !authority.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if config.owner() != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining = data;
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let fee: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let _bump_config = bump_seed(program_id, &[b"program-config"], config.key())?;
    if !(fee <= 10_000_000_000) {
        return Err(ConfigError::FeeTooHigh.into());
    }
    let config_account = config;
    let mut config = ProgramConfig::from_account_info(config_account)?;
    if config.authority != *authority.key() {
        return Err(ProgramError::InvalidAccountData);
    }
    config.creation_fee = fee;
    ProgramConfig::save(config_account, &config)?;
    Ok(())

}

=== instructions/set_paused.rs ===
use super::*;
use crate::errors::*;

pub fn set_paused(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 2 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let config = &accounts[0];
    let authority = &accounts[1];

    if !authority.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if config.owner() != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining = data;
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let paused: bool = match arg_bytes[0] {
        0 => false,
        1 => true,
        _ => return Err(ProgramError::InvalidInstructionData),
    };
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let _bump_config = bump_seed(program_id, &[b"program-config"], config.key())?;
    let config_account = config;
    let mut config = ProgramConfig::from_account_info(config_account)?;
    if config.authority != *authority.key() {
        return Err(ProgramError::InvalidAccountData);
    }
    config.paused = paused;
    ProgramConfig::save(config_account, &config)?;
    Ok(())

}

