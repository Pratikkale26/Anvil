entrypoint!(process_instruction);

pub fn process_instruction(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    instruction_data: &[u8],
) -> ProgramResult {
    if instruction_data.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }

    let (discriminator, data) = instruction_data.split_at(8);
    router(program_id, accounts, discriminator, data)
}

fn router(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    discriminator: &[u8],
    data: &[u8],
) -> ProgramResult {
    match discriminator {
        [175, 175, 109, 31, 13, 152, 155, 237] => initialize(program_id, accounts, data),
        [133, 250, 37, 21, 110, 163, 26, 121] => set_authority(program_id, accounts, data),
        [30, 100, 118, 0, 113, 56, 97, 70] => set_creation_fee(program_id, accounts, data),
        [57, 97, 196, 95, 195, 206, 106, 136] => set_treasury(program_id, accounts, data),
        [91, 60, 125, 192, 176, 225, 166, 218] => set_paused(program_id, accounts, data),
        _ => Err(ProgramError::InvalidInstructionData),
    }
}

