=== instructions/say_formatted.rs ===
use super::*;

pub fn say_formatted(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 0 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }



    // Args
    let mut remaining = data;
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let amount: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if remaining.len() < 32 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(32);
    remaining = rest;
    let target: [u8; 32] = arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?;
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    {
        let mut __log_buf = [0u8; 256];
        let mut __log_len = 0usize;
        let __seg0 = b"amount: ";
        __log_buf[__log_len..__log_len + __seg0.len()].copy_from_slice(__seg0);
        __log_len += __seg0.len();
        let (__a1, __o1) = u64_to_ascii(amount as u64);
        let __ab1 = &__a1[__o1..];
        __log_buf[__log_len..__log_len + __ab1.len()].copy_from_slice(__ab1);
        __log_len += __ab1.len();
        let __seg2 = b" target: ";
        __log_buf[__log_len..__log_len + __seg2.len()].copy_from_slice(__seg2);
        __log_len += __seg2.len();
        let (__a3, __o3) = pubkey_to_base58(&target);
        let __ab3 = &__a3[__o3..];
        __log_buf[__log_len..__log_len + __ab3.len()].copy_from_slice(__ab3);
        __log_len += __ab3.len();
        let __log_str = unsafe { core::str::from_utf8_unchecked(&__log_buf[..__log_len]) };
        pinocchio::log::sol_log(__log_str);
    }
    {
        let mut __log_buf = [0u8; 256];
        let mut __log_len = 0usize;
        let __seg0 = b"count: ";
        __log_buf[__log_len..__log_len + __seg0.len()].copy_from_slice(__seg0);
        __log_len += __seg0.len();
        let (__a1, __o1) = u64_to_ascii(amount as u64);
        let __ab1 = &__a1[__o1..];
        __log_buf[__log_len..__log_len + __ab1.len()].copy_from_slice(__ab1);
        __log_len += __ab1.len();
        let __log_str = unsafe { core::str::from_utf8_unchecked(&__log_buf[..__log_len]) };
        pinocchio::log::sol_log(__log_str);
    }
    Ok(())

}

=== instructions/say_hello.rs ===
use super::*;

pub fn say_hello(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 0 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }



    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    pinocchio::log::sol_log("hello world");
    pinocchio::log::sol_log("second line");
    Ok(())

}

=== instructions/say_status.rs ===
use super::*;

pub fn say_status(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 0 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }



    // Args
    let mut remaining = data;
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let ok: bool = match arg_bytes[0] {
        0 => false,
        1 => true,
        _ => return Err(ProgramError::InvalidInstructionData),
    };
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    if ok {
            pinocchio::log::sol_log("status: ok");
        } else {
            pinocchio::log::sol_log("status: bad");
        }
    pinocchio::log::sol_log("done");
    Ok(())

}

