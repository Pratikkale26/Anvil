//! State account definitions for DerefStripComparisonPattern

//! Generated by Anvil v0.3.0 — Target: Pinocchio


use super::*;

#[repr(C)]
pub struct Proposal {
    pub approvals: u32,
    pub signers: Vec<Pubkey>,
}

impl Proposal {
    pub const DISCRIMINATOR: [u8; 8] = [26, 94, 189, 187, 116, 136, 53, 33];
    pub const INIT_SPACE: usize = 36;
    pub const LEN: usize = 36;
    pub const TOTAL_LEN: usize = 8 + Self::LEN;
    pub const SPACE: usize = Self::TOTAL_LEN;
    pub const SIZE: usize = Self::TOTAL_LEN;

    pub fn read(data: &[u8]) -> Result<Self, ProgramError> {
        if data.len() < Self::TOTAL_LEN {
            return Err(ProgramError::InvalidAccountData);
        }
        if data[..8] != Self::DISCRIMINATOR {
            return Err(ProgramError::InvalidAccountData);
        }
        let mut offset = 8usize;
        let approvals: u32 = u32::from_le_bytes(
            data[offset..offset + 4].try_into().map_err(|_| ProgramError::InvalidAccountData)?
        );
        offset += 4;
        let mut signers_bytes: &[u8] = &data[offset..];
        let __signers_before = signers_bytes.len();
        let signers: Vec<Pubkey> = BorshDeserialize::deserialize(&mut signers_bytes)
            .map_err(|_| ProgramError::InvalidAccountData)?;
        offset += __signers_before - signers_bytes.len();
        Ok(Self { approvals, signers })
    }

    pub fn write(data: &mut [u8], value: &Self) -> ProgramResult {
        if data.len() < Self::TOTAL_LEN {
            return Err(ProgramError::InvalidAccountData);
        }
        data[..8].copy_from_slice(&Self::DISCRIMINATOR);
        let mut offset = 8usize;
        data[offset..offset + 4].copy_from_slice(&value.approvals.to_le_bytes());
        offset += 4;
        let __signers_serialized = ::borsh::to_vec(&value.signers)
            .map_err(|_| ProgramError::InvalidAccountData)?;
        data[offset..offset + __signers_serialized.len()].copy_from_slice(&__signers_serialized);
        offset += __signers_serialized.len();
        Ok(())
    }

    pub fn from_account_info(account: &AccountInfo) -> Result<Self, ProgramError> {
        let data = unsafe { account.borrow_data_unchecked() };
        Self::read(&data)
    }

    pub fn save(account: &AccountInfo, value: &Self) -> ProgramResult {
        let mut data = unsafe { account.borrow_mut_data_unchecked() };
        Self::write(&mut data, value)
    }
}