=== helpers.rs ===
//! Helper functions for AtaMint

use super::*;

pub fn spl_token_mint_to<'a>(
    mint: &AccountInfo<'a>,
    to: &AccountInfo<'a>,
    authority: &AccountInfo<'a>,
    amount: u64,
) -> ProgramResult {
    let mint_ix = spl_token::instruction::mint_to(
        &spl_token::id(),
        mint.key,
        to.key,
        authority.key,
        &[],
        amount,
    )?;
    invoke(
        &mint_ix,
        &[mint.clone(), to.clone(), authority.clone()],
    )?;
    Ok(())
}

=== instructions/mint_with_ata.rs ===
use super::*;
use solana_program::program::invoke;

pub fn mint_with_ata(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 7 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;

    let payer = &accounts[0];
    let mint = &accounts[1];
    let recipient = &accounts[2];
    let recipient_ata = &accounts[3];
    let token_program = &accounts[4];
    let ata_program = &accounts[5];
    let _system_program = &accounts[6];

    if !payer.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !payer.is_writable || !mint.is_writable || !recipient_ata.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }
    if *mint.owner != Pubkey::new_from_array([6, 221, 246, 225, 215, 101, 161, 147, 217, 203, 225, 70, 206, 235, 121, 172, 28, 180, 133, 237, 95, 91, 55, 145, 58, 140, 245, 133, 126, 255, 0, 169]) {
        return Err(ProgramError::IncorrectProgramId);
    }
    if *token_program.key != Pubkey::new_from_array([6, 221, 246, 225, 215, 101, 161, 147, 217, 203, 225, 70, 206, 235, 121, 172, 28, 180, 133, 237, 95, 91, 55, 145, 58, 140, 245, 133, 126, 255, 0, 169]) {
        return Err(ProgramError::IncorrectProgramId);
    }
    if *ata_program.key != Pubkey::new_from_array([140, 151, 37, 143, 78, 36, 137, 241, 187, 61, 16, 41, 20, 142, 13, 131, 11, 90, 19, 153, 218, 255, 16, 132, 4, 142, 123, 216, 219, 233, 248, 89]) {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining: &[u8] = __ix_data;
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let amount: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    // Create Associated Token Account: recipient_ata
    let create_ata_ix = spl_create_ata_ix(
        payer.key,
        recipient.key,
        mint.key,
        &spl_token::id(),
    );
    invoke(
        &create_ata_ix,
        &[payer.clone(), recipient_ata.clone(), recipient.clone(), mint.clone()],
    )?;
    // SPL Token mint_to — mint → recipient_ata
    let mint_ix = spl_token::instruction::mint_to(
        &spl_token::id(),
        mint.key,
        recipient_ata.key,
        payer.key,
        &[],
        amount,
    )?;
    invoke(
        &mint_ix,
        &[mint.clone(), recipient_ata.clone(), payer.clone()],
    )?;
    Ok(())

}

