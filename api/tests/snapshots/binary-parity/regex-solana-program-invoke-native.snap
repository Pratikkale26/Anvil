=== instructions/raw_invoke.rs ===
use super::*;
use solana_program::program::invoke;

pub fn raw_invoke(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;

    let target_account = &accounts[0];
    let authority = &accounts[1];
    let target_program = &accounts[2];

    if !authority.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !target_account.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }

    // Args
    let mut remaining: &[u8] = __ix_data;
    let payload: Vec<u8> = BorshDeserialize::deserialize(&mut remaining)
        .map_err(|_| ProgramError::InvalidInstructionData)?;
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let ix = Instruction {
            program_id: *target_program.key,
            accounts: vec![
                AccountMeta::new(*target_account.key, false),
                AccountMeta::new_readonly(*authority.key, true),
            ],
            data: payload,
        };
    solana_program::program::invoke(
            &ix,
            &[
                target_account.clone(),
                authority.clone(),
                target_program.clone(),
            ],
        )?;
    Ok(())

}

