=== helpers.rs ===
//! Helper functions for HasOneDemo

use super::*;
use crate::state::*;

pub fn create_program_account<'a>(
    account: &AccountInfo<'a>,
    payer: &AccountInfo<'a>,
    space: u64,
    program_id: &Pubkey,
    signer_seeds: &[&[&[u8]]],
) -> ProgramResult {
    let rent = solana_program::sysvar::rent::Rent::get()?;
    let lamports = rent.minimum_balance(space as usize);
    let create_ix = system_instruction::create_account(
        payer.key,
        account.key,
        lamports,
        space,
        program_id,
    );
    invoke_signed(
        &create_ix,
        &[payer.clone(), account.clone()],
        signer_seeds,
    )?;
    Ok(())
}

=== instructions/bump_value.rs ===
use super::*;

pub fn bump_value(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 2 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;

    let safe = &accounts[0];
    let owner = &accounts[1];

    if !owner.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !safe.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }
    if safe.owner != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining: &[u8] = __ix_data;
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let by: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let safe_account = safe;
    let mut safe = Safe::read(&safe_account.data.borrow())?;
    if safe.owner != *owner.key {
        return Err(ProgramError::InvalidAccountData);
    }
    safe.value = safe.value.saturating_add(by);
    Safe::write(&mut safe_account.data.borrow_mut(), &safe)?;
    Ok(())

}

=== instructions/initialize.rs ===
use super::*;

pub fn initialize(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;

    let safe = &accounts[0];
    let owner = &accounts[1];
    let _system_program = &accounts[2];

    if !owner.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !safe.is_writable || !owner.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }

    if !__ix_data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    create_program_account(safe, owner, (8 + 32 + 8) as u64, program_id, &[])?;
    {
        let mut __init_data = safe.data.borrow_mut();
        __init_data[..8].copy_from_slice(&Safe::DISCRIMINATOR);
    }
    let safe_account = safe;
    let mut safe = Safe { owner: Pubkey::default(), value: 0 };
    safe.owner = *owner.key;
    safe.value = 0;
    Safe::write(&mut safe_account.data.borrow_mut(), &safe)?;
    Ok(())

}

