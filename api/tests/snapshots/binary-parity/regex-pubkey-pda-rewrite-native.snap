//! Error definitions for PubkeyPdaRewritePattern

use super::*;

#[derive(Clone, Copy, Debug, PartialEq)]
#[repr(u32)]
pub enum PdaError {
    /// PDA mismatch
    Mismatch = 6000,
}

pub use PdaError::*;

impl From<PdaError> for ProgramError {
    fn from(error: PdaError) -> Self {
        ProgramError::Custom(error as u32)
    }
}

impl std::fmt::Display for PdaError {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        write!(f, "{:?}", self)
    }
}

impl std::error::Error for PdaError {}

=== instructions/check_pda.rs ===
use super::*;
use crate::errors::*;

pub fn check_pda(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 1 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;

    let candidate = &accounts[0];

    // Args
    let mut remaining: &[u8] = __ix_data;
    let seed: Vec<u8> = BorshDeserialize::deserialize(&mut remaining)
        .map_err(|_| ProgramError::InvalidInstructionData)?;
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let (derived, _bump) = Pubkey::find_program_address(
            &[b"counter", seed.as_ref()],
            program_id,
        );
    if derived != *candidate.key {
        return Err(ProgramError::from(PdaError::Mismatch).into());
    }
    Ok(())

}

