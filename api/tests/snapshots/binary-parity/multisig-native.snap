//! MultisigDemo — generated by Anvil v0.4.0
//! Source framework: Anchor → Target: Native
//!
//! This code was automatically generated. Sections marked with
//! "⚠️ Anvil: Review" should be verified before deployment.
#![deny(clippy::all)]
#![allow(unexpected_cfgs, dead_code, deprecated, unused_imports)]

use borsh::{BorshDeserialize, BorshSerialize};
use solana_program::{
    account_info::AccountInfo,
    entrypoint,
    entrypoint::ProgramResult,
    program::invoke_signed,
    program_error::ProgramError,
    pubkey::Pubkey,
    system_instruction,
    sysvar::Sysvar,
};

// G19 — Anchor's declare_id!() expands to these two items at crate root.
// Carried code may reference `crate::ID` or `crate::id()` for ownership
// checks and PDA derivations — stub them so emit stays compilable.
pub const ID: Pubkey = Pubkey::new_from_array([5, 90, 204, 241, 70, 167, 83, 233, 181, 63, 179, 100, 53, 92, 30, 120, 176, 1, 87, 129, 151, 141, 47, 238, 74, 205, 147, 168, 0, 0, 0, 0]);
pub fn id() -> Pubkey { ID }



mod state;

mod instructions;

mod errors;

mod helpers;

use instructions::*;

pub use errors::*;

use state::*;

use helpers::*;

entrypoint!(process_instruction);

pub fn process_instruction(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    instruction_data: &[u8],
) -> ProgramResult {
    if program_id != &ID {
        return Err(ProgramError::IncorrectProgramId);
    }

    if instruction_data.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }

    let (discriminator, data) = instruction_data.split_at(8);
    router(program_id, accounts, discriminator, data)
}

fn router(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    discriminator: &[u8],
    data: &[u8],
) -> ProgramResult {
    match discriminator {
        [24, 30, 200, 40, 5, 28, 7, 119] => create(program_id, accounts, data),
        [93, 253, 82, 168, 118, 33, 102, 90] => propose(program_id, accounts, data),
        [69, 74, 217, 36, 115, 117, 97, 76] => approve(program_id, accounts, data),
        [130, 221, 242, 154, 13, 193, 189, 29] => execute(program_id, accounts, data),
        _ => Err(ProgramError::InvalidInstructionData),
    }
}

