//! State account definitions for MultisigDemo

//! Generated by Anvil v0.4.0 — Target: Native


use super::*;

use crate::errors::*;

#[repr(C)]
pub struct MultisigAccount {
    pub owners: Vec<Pubkey>,
    pub threshold: u8,
    pub proposal_count: u64,
    pub bump: u8,
}

impl MultisigAccount {
    pub const DISCRIMINATOR: [u8; 8] = [77, 9, 180, 199, 183, 246, 156, 81];
    pub const INIT_SPACE: usize = 42;
    pub const LEN: usize = 42;
    pub const TOTAL_LEN: usize = 8 + Self::LEN;
    pub const SPACE: usize = Self::TOTAL_LEN;
    pub const SIZE: usize = Self::TOTAL_LEN;
    /// Minimum data length the read/write guard checks against for variable-
    /// length structs (String / Vec fields). Discriminator + every variable
    /// field's 4-byte length prefix + every fixed field's full size.
    pub const MIN_LEN: usize = 22;

    pub fn read(data: &[u8]) -> Result<Self, ProgramError> {
        if data.len() < Self::MIN_LEN {
            return Err(ProgramError::InvalidAccountData);
        }
        if data[..8] != Self::DISCRIMINATOR {
            return Err(ProgramError::InvalidAccountData);
        }
        // Alias to dodge field-name shadowing — a field named `data` would
        // shadow the parameter and break subsequent field reads.
        let __data_buf: &[u8] = data;
        let mut offset = 8usize;
        let mut owners_bytes: &[u8] = &__data_buf[offset..];
        let __owners_before = owners_bytes.len();
        let owners: Vec<Pubkey> = BorshDeserialize::deserialize(&mut owners_bytes)
            .map_err(|_| ProgramError::InvalidAccountData)?;
        offset += __owners_before - owners_bytes.len();
        let threshold: u8 = __data_buf[offset];
        offset += 1;
        let proposal_count: u64 = u64::from_le_bytes(
            __data_buf[offset..offset + 8].try_into().map_err(|_| ProgramError::InvalidAccountData)?
        );
        offset += 8;
        let bump: u8 = __data_buf[offset];
        Ok(Self { owners, threshold, proposal_count, bump })
    }

    pub fn write(data: &mut [u8], value: &Self) -> ProgramResult {
        if data.len() < Self::MIN_LEN {
            return Err(ProgramError::InvalidAccountData);
        }
        data[..8].copy_from_slice(&Self::DISCRIMINATOR);
        let __data_buf: &mut [u8] = data;
        let mut offset = 8usize;
        let __owners_serialized = ::borsh::to_vec(&value.owners)
            .map_err(|_| ProgramError::InvalidAccountData)?;
        __data_buf[offset..offset + __owners_serialized.len()].copy_from_slice(&__owners_serialized);
        offset += __owners_serialized.len();
        __data_buf[offset] = value.threshold as u8;
        offset += 1;
        __data_buf[offset..offset + 8].copy_from_slice(&value.proposal_count.to_le_bytes());
        offset += 8;
        __data_buf[offset] = value.bump as u8;
        Ok(())
    }

    /// Borsh-style convenience wrapper: borrow the account's data buffer
    /// and write the value into it. Mirrors Pinocchio's save() so the same
    /// emitter call site (`Type::save(account, &value)`) works on both.
    pub fn save(account: &AccountInfo, value: &Self) -> ProgramResult {
        let mut data = account.try_borrow_mut_data()?;
        Self::write(&mut data, value)
    }

    /// Mirror of Pinocchio's from_account_info — the body emitter calls
    /// `<Type>::from_account_info(account)?` cross-target, so Native
    /// must expose the same signature even though it could equivalently
    /// borrow + read inline. Without this, programs whose handlers don't
    /// directly call `::read(...)` (most non-trivial Anchor sources)
    /// fail Native cargo build with E0599 'no associated item named
    /// from_account_info'.
    pub fn from_account_info(account: &AccountInfo) -> Result<Self, ProgramError> {
        let data = account.try_borrow_data()?;
        Self::read(&data)
    }
}

#[repr(C)]
pub struct ProposalAccount {
    pub multisig: Pubkey,
    pub amount: u64,
    pub approved: Vec<bool>,
    pub executed: bool,
    pub bump: u8,
}

impl ProposalAccount {
    pub const DISCRIMINATOR: [u8; 8] = [164, 190, 4, 248, 203, 124, 243, 64];
    pub const INIT_SPACE: usize = 74;
    pub const LEN: usize = 74;
    pub const TOTAL_LEN: usize = 8 + Self::LEN;
    pub const SPACE: usize = Self::TOTAL_LEN;
    pub const SIZE: usize = Self::TOTAL_LEN;
    /// Minimum data length the read/write guard checks against for variable-
    /// length structs (String / Vec fields). Discriminator + every variable
    /// field's 4-byte length prefix + every fixed field's full size.
    pub const MIN_LEN: usize = 54;

    pub fn read(data: &[u8]) -> Result<Self, ProgramError> {
        if data.len() < Self::MIN_LEN {
            return Err(ProgramError::InvalidAccountData);
        }
        if data[..8] != Self::DISCRIMINATOR {
            return Err(ProgramError::InvalidAccountData);
        }
        // Alias to dodge field-name shadowing — a field named `data` would
        // shadow the parameter and break subsequent field reads.
        let __data_buf: &[u8] = data;
        let mut offset = 8usize;
        let multisig: Pubkey = Pubkey::new_from_array(
            data[offset..offset + 32]
                .try_into()
                .map_err(|_| ProgramError::InvalidAccountData)?
        );
        offset += 32;
        let amount: u64 = u64::from_le_bytes(
            __data_buf[offset..offset + 8].try_into().map_err(|_| ProgramError::InvalidAccountData)?
        );
        offset += 8;
        let mut approved_bytes: &[u8] = &__data_buf[offset..];
        let __approved_before = approved_bytes.len();
        let approved: Vec<bool> = BorshDeserialize::deserialize(&mut approved_bytes)
            .map_err(|_| ProgramError::InvalidAccountData)?;
        offset += __approved_before - approved_bytes.len();
        let executed: bool = match __data_buf[offset] {
            0 => false,
            1 => true,
            _ => return Err(ProgramError::InvalidAccountData),
        };
        offset += 1;
        let bump: u8 = __data_buf[offset];
        Ok(Self { multisig, amount, approved, executed, bump })
    }

    pub fn write(data: &mut [u8], value: &Self) -> ProgramResult {
        if data.len() < Self::MIN_LEN {
            return Err(ProgramError::InvalidAccountData);
        }
        data[..8].copy_from_slice(&Self::DISCRIMINATOR);
        let __data_buf: &mut [u8] = data;
        let mut offset = 8usize;
        __data_buf[offset..offset + 32].copy_from_slice(&value.multisig.as_ref());
        offset += 32;
        __data_buf[offset..offset + 8].copy_from_slice(&value.amount.to_le_bytes());
        offset += 8;
        let __approved_serialized = ::borsh::to_vec(&value.approved)
            .map_err(|_| ProgramError::InvalidAccountData)?;
        __data_buf[offset..offset + __approved_serialized.len()].copy_from_slice(&__approved_serialized);
        offset += __approved_serialized.len();
        __data_buf[offset] = if value.executed { 1 } else { 0 };
        offset += 1;
        __data_buf[offset] = value.bump as u8;
        Ok(())
    }

    /// Borsh-style convenience wrapper: borrow the account's data buffer
    /// and write the value into it. Mirrors Pinocchio's save() so the same
    /// emitter call site (`Type::save(account, &value)`) works on both.
    pub fn save(account: &AccountInfo, value: &Self) -> ProgramResult {
        let mut data = account.try_borrow_mut_data()?;
        Self::write(&mut data, value)
    }

    /// Mirror of Pinocchio's from_account_info — the body emitter calls
    /// `<Type>::from_account_info(account)?` cross-target, so Native
    /// must expose the same signature even though it could equivalently
    /// borrow + read inline. Without this, programs whose handlers don't
    /// directly call `::read(...)` (most non-trivial Anchor sources)
    /// fail Native cargo build with E0599 'no associated item named
    /// from_account_info'.
    pub fn from_account_info(account: &AccountInfo) -> Result<Self, ProgramError> {
        let data = account.try_borrow_data()?;
        Self::read(&data)
    }
}