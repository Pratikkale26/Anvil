=== instructions/propose.rs ===
use super::*;
use crate::errors::*;

pub fn propose(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 5 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;

    let multisig = &accounts[0];
    let multisig_payer = &accounts[1];
    let proposal = &accounts[2];
    let proposer = &accounts[3];
    let _system_program = &accounts[4];

    if !proposer.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !proposal.is_writable || !proposer.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }
    if multisig.owner != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining: &[u8] = __ix_data;
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let proposal_id: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let amount: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let (expected_key, bump_proposal) = Pubkey::find_program_address(&[b"proposal", multisig.key.as_ref(), &proposal_id.to_le_bytes()], program_id);
    if expected_key != *proposal.key {
        return Err(ProgramError::InvalidSeeds);
    }
    let init_seed_bytes = proposal_id.to_le_bytes();
    let init_proposal_seeds: &[&[u8]] = &[
            b"proposal",
            multisig.key.as_ref(),
            &init_seed_bytes,
            &[bump_proposal],
        ];
    let init_proposal_signer_seeds = &[&init_proposal_seeds[..]];
    create_program_account(proposal, proposer, (256) as u64, program_id, init_proposal_signer_seeds)?;
    {
        let mut __init_data = proposal.data.borrow_mut();
        __init_data[..8].copy_from_slice(&ProposalAccount::DISCRIMINATOR);
    }
    let (expected_key, _bump_multisig) = Pubkey::find_program_address(&[b"multisig", multisig_payer.key.as_ref()], program_id);
    if expected_key != *multisig.key {
        return Err(ProgramError::InvalidSeeds);
    }
    let _ = proposal_id;
    let m = MultisigAccount::read(&multisig.data.borrow())?;
    let mut p = ProposalAccount {
        multisig: Pubkey::default(),
        amount: 0,
        approved: Vec::<bool>::default(),
        executed: false,
        bump: 0,
    };
    let proposer_key = *proposer.key;
    let is_owner = m.owners.iter().any(|o| o == &proposer_key);
    if !is_owner {
        return Err(MultisigError::NotAnOwner.into());
    }
    p.multisig = *multisig.key;
    p.amount = amount;
    p.approved = vec![false; m.owners.len()];
    p.executed = false;
    p.bump = bump_proposal;
    ProposalAccount::write(&mut proposal.data.borrow_mut(), &p)?;
    Ok(())

}

