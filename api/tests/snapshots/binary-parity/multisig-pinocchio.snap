=== instructions/propose.rs ===
use super::*;
use crate::errors::*;

pub fn propose(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 5 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let multisig = &accounts[0];
    let multisig_payer = &accounts[1];
    let proposal = &accounts[2];
    let proposer = &accounts[3];
    let _system_program = &accounts[4];

    if !proposer.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !proposal.is_writable() || !proposer.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }

    // Args
    let mut remaining = data;
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let proposal_id: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let amount: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let seed_bytes = proposal_id.to_le_bytes();
    let bump_proposal = bump_seed(program_id, &[b"proposal", multisig.key().as_ref(), &seed_bytes], proposal.key())?;
    let init_seed_bytes = proposal_id.to_le_bytes();
    let init_proposal_seeds: &[&[u8]] = &[
            b"proposal",
            multisig.key().as_ref(),
            &init_seed_bytes,
            &[bump_proposal],
        ];
    let init_proposal_signer_seeds = &[&init_proposal_seeds[..]];
    create_program_account(proposal, proposer, (256) as usize, program_id, init_proposal_signer_seeds)?;
    {
        let mut __init_data = unsafe { proposal.borrow_mut_data_unchecked() };
        __init_data[..8].copy_from_slice(&ProposalAccount::DISCRIMINATOR);
    }
    let _bump_multisig = bump_seed(program_id, &[b"multisig", multisig_payer.key().as_ref()], multisig.key())?;
    let _ = proposal_id;
    let m = MultisigAccount::from_account_info(multisig)?;
    let mut p = ProposalAccount {
        multisig: [0u8; 32],
        amount: 0,
        approved: Vec::<bool>::default(),
        executed: false,
        bump: 0,
    };
    let proposer_key = *proposer.key();
    let is_owner = m.owners.iter().any(|o| o == &proposer_key);
    if !is_owner {
        return Err(MultisigError::NotAnOwner.into());
    }
    p.multisig = *multisig.key();
    p.amount = amount;
    p.approved = vec![false; m.owners.len()];
    p.executed = false;
    p.bump = bump_proposal;
    ProposalAccount::save(proposal, &p)?;
    Ok(())

}

