=== errors.rs ===
//! Error definitions for MultisigDemo

use super::*;

#[derive(Clone, Copy, Debug, PartialEq)]
#[repr(u32)]
pub enum MultisigError {
    /// Threshold must be > 0 and ≤ owners.len()
    InvalidThreshold = 6000,
    /// Too many owners (max 8)
    TooManyOwners = 6001,
    /// Signer is not an owner
    NotAnOwner = 6002,
    /// Proposal already executed
    AlreadyExecuted = 6003,
    /// Not enough approvals to reach threshold
    NotEnoughApprovals = 6004,
}

pub use MultisigError::*;

impl From<MultisigError> for ProgramError {
    fn from(error: MultisigError) -> Self {
        ProgramError::Custom(error as u32)
    }
}

=== helpers.rs ===
//! Helper functions for MultisigDemo

use super::*;
use crate::state::*;
use crate::errors::*;

pub fn bump_seed(
    program_id: &Pubkey,
    seeds: &[&[u8]],
    expected: &Pubkey,
) -> Result<u8, ProgramError> {
    for bump in (0..=255u8).rev() {
        let mut seeds_with_bump: [&[u8]; 16] = [&[]; 16];
        let len = seeds.len().min(15);
        seeds_with_bump[..len].copy_from_slice(&seeds[..len]);
        let bump_slice = &[bump];
        seeds_with_bump[len] = bump_slice;
        if let Ok(derived) = pinocchio::pubkey::create_program_address(&seeds_with_bump[..len + 1], program_id) {
            if &derived == expected {
                return Ok(bump);
            }
        }
    }
    Err(ProgramError::InvalidSeeds)
}

pub fn create_program_account(
    account: &AccountInfo,
    payer: &AccountInfo,
    space: usize,
    program_id: &Pubkey,
    signer_seeds: &[&[&[u8]]],
) -> ProgramResult {
    if signer_seeds.len() > 1 {
        return Err(ProgramError::InvalidSeeds);
    }

    let signer_storage = signer_seeds.first().map(|seed_group| {
        let mut seeds: [Seed<'_>; 8] = core::array::from_fn(|_| Seed::from(&[][..]));
        for (index, seed) in seed_group.iter().enumerate() {
            if index >= seeds.len() {
                return Err(ProgramError::InvalidSeeds);
            }
            seeds[index] = Seed::from(*seed);
        }
        Ok((seeds, seed_group.len()))
    }).transpose()?;

    let signer_slice = if let Some((ref seeds, len)) = signer_storage {
        let signer = Signer::from(&seeds[..len]);
        create_account_with_minimum_balance_signed(account, space, program_id, payer, None, &[signer])
    } else {
        create_account_with_minimum_balance_signed(account, space, program_id, payer, None, &[])
    };

    signer_slice
}

=== instructions/approve.rs ===
use super::*;
use crate::errors::*;

pub fn approve(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 4 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let multisig = &accounts[0];
    let multisig_payer = &accounts[1];
    let proposal = &accounts[2];
    let signer = &accounts[3];

    if !signer.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !proposal.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }
    if proposal.owner() != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let _bump_multisig = bump_seed(program_id, &[b"multisig", multisig_payer.key().as_ref()], multisig.key())?;
    let m = MultisigAccount::from_account_info(multisig)?;
    let mut p = ProposalAccount::from_account_info(proposal)?;
    if p.multisig != *multisig.key() {
        return Err(ProgramError::InvalidAccountData);
    }
    if p.executed {
        return Err(MultisigError::AlreadyExecuted.into());
    }
    let signer_key = *signer.key();
    let idx = m.owners.iter().position(|o| o == &signer_key).ok_or(MultisigError::NotAnOwner)?;
    p.approved[idx] = true;
    ProposalAccount::save(proposal, &p)?;
    Ok(())

}

=== instructions/create.rs ===
use super::*;
use crate::errors::*;

pub fn create(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let multisig = &accounts[0];
    let payer = &accounts[1];
    let _system_program = &accounts[2];

    if !payer.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !multisig.is_writable() || !payer.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }

    // Args
    let mut remaining = data;
    let owners: Vec<Pubkey> = BorshDeserialize::deserialize(&mut remaining)
        .map_err(|_| ProgramError::InvalidInstructionData)?;
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let threshold: u8 = arg_bytes[0];
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let bump_multisig = bump_seed(program_id, &[b"multisig", payer.key().as_ref()], multisig.key())?;
    let init_multisig_seeds: &[&[u8]] = &[
            b"multisig",
            payer.key().as_ref(),
            &[bump_multisig],
        ];
    let init_multisig_signer_seeds = &[&init_multisig_seeds[..]];
    create_program_account(multisig, payer, (8 + 4 + 32 * 8 + 1 + 8 + 1) as usize, program_id, init_multisig_signer_seeds)?;
    {
        let mut __init_data = unsafe { multisig.borrow_mut_data_unchecked() };
        __init_data[..8].copy_from_slice(&MultisigAccount::DISCRIMINATOR);
    }
    if !(threshold > 0 && (threshold as usize) <= owners.len()) {
        return Err(MultisigError::InvalidThreshold.into());
    }
    if !(owners.len() <= 8) {
        return Err(MultisigError::TooManyOwners.into());
    }
    let mut m = MultisigAccount {
        owners: Vec::<Pubkey>::default(),
        threshold: 0,
        proposal_count: 0,
        bump: 0,
    };
    m.owners = owners;
    m.threshold = threshold;
    m.proposal_count = 0;
    m.bump = bump_multisig;
    MultisigAccount::save(multisig, &m)?;
    Ok(())

}

=== instructions/execute.rs ===
use super::*;
use crate::errors::*;

pub fn execute(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 4 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let multisig = &accounts[0];
    let multisig_payer = &accounts[1];
    let proposal = &accounts[2];
    let executor = &accounts[3];

    if !executor.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !proposal.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }
    if proposal.owner() != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let _bump_multisig = bump_seed(program_id, &[b"multisig", multisig_payer.key().as_ref()], multisig.key())?;
    let m = MultisigAccount::from_account_info(multisig)?;
    let mut p = ProposalAccount::from_account_info(proposal)?;
    if p.multisig != *multisig.key() {
        return Err(ProgramError::InvalidAccountData);
    }
    if p.executed {
        return Err(MultisigError::AlreadyExecuted.into());
    }
    let executor_key = *executor.key();
    let is_owner = m.owners.iter().any(|o| o == &executor_key);
    if !is_owner {
        return Err(MultisigError::NotAnOwner.into());
    }
    let approval_count: u8 = p.approved.iter().filter(|&&a| a).count() as u8;
    if !(approval_count >= m.threshold) {
        return Err(MultisigError::NotEnoughApprovals.into());
    }
    p.executed = true;
    ProposalAccount::save(proposal, &p)?;
    Ok(())

}

