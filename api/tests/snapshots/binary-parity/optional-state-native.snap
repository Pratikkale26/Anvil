=== errors.rs ===
//! Error definitions for OptionalStateDemo

use super::*;

#[derive(Clone, Copy, Debug, PartialEq)]
#[repr(u32)]
pub enum VaultError {
    /// Balance overflow
    Overflow = 6000,
}

pub use VaultError::*;

impl From<VaultError> for ProgramError {
    fn from(error: VaultError) -> Self {
        ProgramError::Custom(error as u32)
    }
}

impl std::fmt::Display for VaultError {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        write!(f, "{:?}", self)
    }
}

impl std::error::Error for VaultError {}

=== helpers.rs ===
//! Helper functions for OptionalStateDemo

use super::*;
use crate::state::*;
use crate::errors::*;

pub fn create_program_account<'a>(
    account: &AccountInfo<'a>,
    payer: &AccountInfo<'a>,
    space: u64,
    program_id: &Pubkey,
    signer_seeds: &[&[&[u8]]],
) -> ProgramResult {
    let rent = solana_program::sysvar::rent::Rent::get()?;
    let lamports = rent.minimum_balance(space as usize);
    let create_ix = system_instruction::create_account(
        payer.key,
        account.key,
        lamports,
        space,
        program_id,
    );
    invoke_signed(
        &create_ix,
        &[payer.clone(), account.clone()],
        signer_seeds,
    )?;
    Ok(())
}

=== instructions/clear_delegate.rs ===
use super::*;
use crate::errors::*;

pub fn clear_delegate(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 2 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let vault = &accounts[0];
    let owner = &accounts[1];

    if !owner.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !vault.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }
    if vault.owner != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let (expected_key, _bump_vault) = Pubkey::find_program_address(&[b"opt-vault", owner.key.as_ref()], program_id);
    if expected_key != *vault.key {
        return Err(ProgramError::InvalidSeeds);
    }
    let mut v = OptVault::read(&vault.data.borrow())?;
    if v.owner != *owner.key {
        return Err(ProgramError::InvalidAccountData);
    }
    v.delegate = None;
    OptVault::write(&mut vault.data.borrow_mut(), &v)?;
    Ok(())

}

=== instructions/deposit.rs ===
use super::*;
use crate::errors::*;

pub fn deposit(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 2 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let vault = &accounts[0];
    let owner = &accounts[1];

    if !owner.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !vault.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }
    if vault.owner != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining = data;
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let amount: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let (expected_key, _bump_vault) = Pubkey::find_program_address(&[b"opt-vault", owner.key.as_ref()], program_id);
    if expected_key != *vault.key {
        return Err(ProgramError::InvalidSeeds);
    }
    let mut v = OptVault::read(&vault.data.borrow())?;
    if v.owner != *owner.key {
        return Err(ProgramError::InvalidAccountData);
    }
    v.balance = v.balance.checked_add(amount).ok_or(VaultError::Overflow)?;
    OptVault::write(&mut vault.data.borrow_mut(), &v)?;
    Ok(())

}

=== instructions/init.rs ===
use super::*;
use crate::errors::*;

pub fn init(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let vault = &accounts[0];
    let owner = &accounts[1];
    let _system_program = &accounts[2];

    if !owner.is_signer {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !vault.is_writable || !owner.is_writable {
        return Err(ProgramError::InvalidAccountData);
    }

    // Args
    let mut remaining = data;
    let delegate: Option<Pubkey> = BorshDeserialize::deserialize(&mut remaining)
        .map_err(|_| ProgramError::InvalidInstructionData)?;
    let expiry: Option<i64> = BorshDeserialize::deserialize(&mut remaining)
        .map_err(|_| ProgramError::InvalidInstructionData)?;
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let (expected_key, bump_vault) = Pubkey::find_program_address(&[b"opt-vault", owner.key.as_ref()], program_id);
    if expected_key != *vault.key {
        return Err(ProgramError::InvalidSeeds);
    }
    let init_vault_seeds: &[&[u8]] = &[
            b"opt-vault",
            owner.key.as_ref(),
            &[bump_vault],
        ];
    let init_vault_signer_seeds = &[&init_vault_seeds[..]];
    create_program_account(vault, owner, (256) as u64, program_id, init_vault_signer_seeds)?;
    {
        let mut __init_data = vault.data.borrow_mut();
        __init_data[..8].copy_from_slice(&OptVault::DISCRIMINATOR);
    }
    let mut v = OptVault {
        owner: Pubkey::default(),
        delegate: Option::<Pubkey>::default(),
        expiry: Option::<i64>::default(),
        balance: 0,
        bump: 0,
    };
    v.owner = *owner.key;
    v.delegate = delegate;
    v.expiry = expiry;
    v.balance = 0;
    v.bump = bump_vault;
    OptVault::write(&mut vault.data.borrow_mut(), &v)?;
    Ok(())

}

