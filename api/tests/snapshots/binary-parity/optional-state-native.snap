//! OptionalStateDemo — generated by Anvil v0.3.0
//! Source framework: Anchor → Target: Native
//!
//! This code was automatically generated. Sections marked with
//! "⚠️ Anvil: Review" should be verified before deployment.
#![deny(clippy::all)]
#![allow(unexpected_cfgs, dead_code, deprecated, unused_imports)]

use borsh::{BorshDeserialize, BorshSerialize};
use solana_program::{
    account_info::AccountInfo,
    entrypoint,
    entrypoint::ProgramResult,
    program::invoke_signed,
    program_error::ProgramError,
    pubkey::Pubkey,
    system_instruction,
    sysvar::Sysvar,
};

// G19 — Anchor's declare_id!() expands to these two items at crate root.
// Carried code may reference `crate::ID` or `crate::id()` for ownership
// checks and PDA derivations — stub them so emit stays compilable.
pub const ID: Pubkey = Pubkey::new_from_array([11, 254, 222, 161, 124, 175, 78, 49, 239, 132, 80, 193, 106, 170, 87, 126, 49, 79, 115, 149, 225, 119, 248, 116, 134, 33, 169, 128, 0, 0, 0, 0]);
pub fn id() -> Pubkey { ID }



mod state;

mod instructions;

mod errors;

mod helpers;

use instructions::*;

pub use errors::*;

use state::*;

use helpers::*;

entrypoint!(process_instruction);

pub fn process_instruction(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    instruction_data: &[u8],
) -> ProgramResult {
    if instruction_data.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }

    let (discriminator, data) = instruction_data.split_at(8);
    router(program_id, accounts, discriminator, data)
}

fn router(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    discriminator: &[u8],
    data: &[u8],
) -> ProgramResult {
    match discriminator {
        [220, 59, 207, 236, 108, 250, 47, 100] => init(program_id, accounts, data),
        [242, 35, 198, 137, 82, 225, 242, 182] => deposit(program_id, accounts, data),
        [225, 42, 179, 59, 112, 79, 196, 149] => clear_delegate(program_id, accounts, data),
        _ => Err(ProgramError::InvalidInstructionData),
    }
}

