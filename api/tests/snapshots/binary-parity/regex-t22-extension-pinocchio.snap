use super::*;

pub fn read_extension(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 1 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let mint = &accounts[0];

    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    // ⚠️ Anvil TODO: Token-2022 extension call site has no pinocchio equivalent — manual port required
// let mint_data = mint.data.borrow();

    // ⚠️ Anvil: formatted msg!() collapsed to static sol_log for Pinocchio
    pinocchio::log::sol_log("mint data len: {}");
    Ok(())

}

