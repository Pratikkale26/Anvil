=== errors.rs ===
//! Error definitions for OptionalStateDemo

use super::*;

#[derive(Clone, Copy, Debug, PartialEq)]
#[repr(u32)]
pub enum VaultError {
    /// Balance overflow
    Overflow = 6000,
}

pub use VaultError::*;

impl From<VaultError> for ProgramError {
    fn from(error: VaultError) -> Self {
        ProgramError::Custom(error as u32)
    }
}

=== helpers.rs ===
//! Helper functions for OptionalStateDemo

use super::*;
use crate::state::*;
use crate::errors::*;

pub fn bump_seed(
    program_id: &Pubkey,
    seeds: &[&[u8]],
    expected: &Pubkey,
) -> Result<u8, ProgramError> {
    for bump in (0..=255u8).rev() {
        let mut seeds_with_bump: [&[u8]; 16] = [&[]; 16];
        let len = seeds.len().min(15);
        seeds_with_bump[..len].copy_from_slice(&seeds[..len]);
        let bump_slice = &[bump];
        seeds_with_bump[len] = bump_slice;
        if let Ok(derived) = pinocchio::pubkey::create_program_address(&seeds_with_bump[..len + 1], program_id) {
            if &derived == expected {
                return Ok(bump);
            }
        }
    }
    Err(ProgramError::InvalidSeeds)
}

pub fn create_program_account(
    account: &AccountInfo,
    payer: &AccountInfo,
    space: usize,
    program_id: &Pubkey,
    signer_seeds: &[&[&[u8]]],
) -> ProgramResult {
    if signer_seeds.len() > 1 {
        return Err(ProgramError::InvalidSeeds);
    }

    let signer_storage = signer_seeds.first().map(|seed_group| {
        let mut seeds: [Seed<'_>; 8] = core::array::from_fn(|_| Seed::from(&[][..]));
        for (index, seed) in seed_group.iter().enumerate() {
            if index >= seeds.len() {
                return Err(ProgramError::InvalidSeeds);
            }
            seeds[index] = Seed::from(*seed);
        }
        Ok((seeds, seed_group.len()))
    }).transpose()?;

    let signer_slice = if let Some((ref seeds, len)) = signer_storage {
        let signer = Signer::from(&seeds[..len]);
        create_account_with_minimum_balance_signed(account, space, program_id, payer, None, &[signer])
    } else {
        create_account_with_minimum_balance_signed(account, space, program_id, payer, None, &[])
    };

    signer_slice
}

=== instructions/clear_delegate.rs ===
use super::*;
use crate::errors::*;

pub fn clear_delegate(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 2 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let vault = &accounts[0];
    let owner = &accounts[1];

    if !owner.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !vault.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }
    if vault.owner() != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let _bump_vault = bump_seed(program_id, &[b"opt-vault", owner.key().as_ref()], vault.key())?;
    let mut v = OptVault::from_account_info(vault)?;
    if v.owner != *owner.key() {
        return Err(ProgramError::InvalidAccountData);
    }
    v.delegate = None;
    OptVault::save(vault, &v)?;
    Ok(())

}

=== instructions/deposit.rs ===
use super::*;
use crate::errors::*;

pub fn deposit(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 2 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let vault = &accounts[0];
    let owner = &accounts[1];

    if !owner.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !vault.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }
    if vault.owner() != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining = data;
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let amount: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let _bump_vault = bump_seed(program_id, &[b"opt-vault", owner.key().as_ref()], vault.key())?;
    let mut v = OptVault::from_account_info(vault)?;
    if v.owner != *owner.key() {
        return Err(ProgramError::InvalidAccountData);
    }
    v.balance = v.balance.checked_add(amount).ok_or(VaultError::Overflow)?;
    OptVault::save(vault, &v)?;
    Ok(())

}

=== instructions/init.rs ===
use super::*;
use crate::errors::*;

pub fn init(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let vault = &accounts[0];
    let owner = &accounts[1];
    let _system_program = &accounts[2];

    if !owner.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !vault.is_writable() || !owner.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }

    // Args
    let mut remaining = data;
    let delegate: Option<Pubkey> = BorshDeserialize::deserialize(&mut remaining)
        .map_err(|_| ProgramError::InvalidInstructionData)?;
    let expiry: Option<i64> = BorshDeserialize::deserialize(&mut remaining)
        .map_err(|_| ProgramError::InvalidInstructionData)?;
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let bump_vault = bump_seed(program_id, &[b"opt-vault", owner.key().as_ref()], vault.key())?;
    let init_vault_seeds: &[&[u8]] = &[
            b"opt-vault",
            owner.key().as_ref(),
            &[bump_vault],
        ];
    let init_vault_signer_seeds = &[&init_vault_seeds[..]];
    create_program_account(vault, owner, (256) as usize, program_id, init_vault_signer_seeds)?;
    {
        let mut __init_data = unsafe { vault.borrow_mut_data_unchecked() };
        __init_data[..8].copy_from_slice(&OptVault::DISCRIMINATOR);
    }
    let mut v = OptVault {
        owner: [0u8; 32],
        delegate: Option::<Pubkey>::default(),
        expiry: Option::<i64>::default(),
        balance: 0,
        bump: 0,
    };
    v.owner = *owner.key();
    v.delegate = delegate;
    v.expiry = expiry;
    v.balance = 0;
    v.bump = bump_vault;
    OptVault::save(vault, &v)?;
    Ok(())

}

