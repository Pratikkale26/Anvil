// Token-2022: uses spl_token_2022 crate for instruction building
use spl_token_2022;

mod instructions;

mod helpers;

use instructions::*;

entrypoint!(process_instruction);

pub fn process_instruction(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    instruction_data: &[u8],
) -> ProgramResult {
    if instruction_data.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }

    let (discriminator, data) = instruction_data.split_at(8);
    router(program_id, accounts, discriminator, data)
}

fn router(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    discriminator: &[u8],
    data: &[u8],
) -> ProgramResult {
    match discriminator {
        [93, 152, 119, 214, 139, 204, 242, 183] => do_transfer(program_id, accounts, data),
        _ => Err(ProgramError::InvalidInstructionData),
    }
}