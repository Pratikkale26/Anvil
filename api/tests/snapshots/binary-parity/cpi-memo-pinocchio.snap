=== instructions/write_memo.rs ===
use super::*;

pub fn write_memo(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 2 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;

    let authority = &accounts[0];
    let memo_program = &accounts[1];

    if !authority.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if memo_program.key() != &[5, 74, 83, 90, 153, 41, 33, 6, 77, 36, 232, 113, 96, 218, 56, 124, 124, 53, 181, 221, 188, 146, 187, 129, 228, 31, 168, 64, 65, 5, 68, 141] {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining: &[u8] = __ix_data;
    let data: Vec<u8> = BorshDeserialize::deserialize(&mut remaining)
        .map_err(|_| ProgramError::InvalidInstructionData)?;
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    // CPI: invoke external program (no-account form -- accounts are inlined below);
    // SPL Memo CPI
    {
        const MEMO_PROGRAM_ID: pinocchio::pubkey::Pubkey = [5, 74, 83, 90, 153, 41, 33, 6, 77, 36, 232, 113, 96, 218, 56, 124, 124, 53, 181, 221, 188, 146, 187, 129, 228, 31, 168, 64, 65, 5, 68, 141];
        let __memo_ix = pinocchio::instruction::Instruction {
            program_id: &MEMO_PROGRAM_ID,
            accounts: &[],
            data: &data,
        };
        pinocchio::cpi::invoke(&__memo_ix, &[])?;
    }
    Ok(())

}

