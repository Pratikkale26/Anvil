=== instructions/say_formatted.rs ===
use super::*;

pub fn say_formatted(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 0 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;



    // Args
    let mut remaining: &[u8] = __ix_data;
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let amount: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if remaining.len() < 32 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(32);
    remaining = rest;
    let target: Pubkey = Pubkey::new_from_array(arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?);
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    msg!("amount: {} target: {}", amount, target);
    msg!("count: {}", amount);
    Ok(())

}

=== instructions/say_hello.rs ===
use super::*;

pub fn say_hello(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 0 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;



    if !__ix_data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    msg!("hello world");
    msg!("second line");
    Ok(())

}

=== instructions/say_status.rs ===
use super::*;

pub fn say_status(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 0 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;



    // Args
    let mut remaining: &[u8] = __ix_data;
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let ok: bool = match arg_bytes[0] {
        0 => false,
        1 => true,
        _ => return Err(ProgramError::InvalidInstructionData),
    };
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    if ok {
            msg!("status: ok");
        } else {
            msg!("status: bad");
        }
    msg!("done");
    Ok(())

}

