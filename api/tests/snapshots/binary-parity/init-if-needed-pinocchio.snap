//! State account definitions for InitIfNeededDemo

//! Generated by Anvil v0.3.0 — Target: Pinocchio


use super::*;

use crate::errors::*;

#[repr(C)]
pub struct VisitProfile {
    pub user: [u8; 32],
    pub visit_count: u64,
    pub last_visit_ts: i64,
}

impl VisitProfile {
    pub const DISCRIMINATOR: [u8; 8] = [14, 4, 235, 248, 18, 81, 215, 91];
    pub const INIT_SPACE: usize = 48;
    pub const LEN: usize = 48;
    pub const TOTAL_LEN: usize = 8 + Self::LEN;
    pub const SPACE: usize = Self::TOTAL_LEN;
    pub const SIZE: usize = Self::TOTAL_LEN;

    pub fn read(data: &[u8]) -> Result<Self, ProgramError> {
        if data.len() < Self::TOTAL_LEN {
            return Err(ProgramError::InvalidAccountData);
        }
        if data[..8] != Self::DISCRIMINATOR {
            return Err(ProgramError::InvalidAccountData);
        }
        let mut offset = 8usize;
        let user: [u8; 32] = data[offset..offset + 32].try_into().map_err(|_| ProgramError::InvalidAccountData)?;
        offset += 32;
        let visit_count: u64 = u64::from_le_bytes(
            data[offset..offset + 8].try_into().map_err(|_| ProgramError::InvalidAccountData)?
        );
        offset += 8;
        let last_visit_ts: i64 = i64::from_le_bytes(
            data[offset..offset + 8].try_into().map_err(|_| ProgramError::InvalidAccountData)?
        );
        Ok(Self { user, visit_count, last_visit_ts })
    }

    pub fn write(data: &mut [u8], value: &Self) -> ProgramResult {
        if data.len() < Self::TOTAL_LEN {
            return Err(ProgramError::InvalidAccountData);
        }
        data[..8].copy_from_slice(&Self::DISCRIMINATOR);
        let mut offset = 8usize;
        data[offset..offset + 32].copy_from_slice(&value.user);
        offset += 32;
        data[offset..offset + 8].copy_from_slice(&value.visit_count.to_le_bytes());
        offset += 8;
        data[offset..offset + 8].copy_from_slice(&value.last_visit_ts.to_le_bytes());
        Ok(())
    }

    pub fn from_account_info(account: &AccountInfo) -> Result<Self, ProgramError> {
        let data = unsafe { account.borrow_data_unchecked() };
        Self::read(&data)
    }

    pub fn save(account: &AccountInfo, value: &Self) -> ProgramResult {
        let mut data = unsafe { account.borrow_mut_data_unchecked() };
        Self::write(&mut data, value)
    }
}