=== instructions/visit.rs ===
use super::*;
use crate::errors::*;

pub fn visit(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let profile = &accounts[0];
    let user = &accounts[1];
    let _system_program = &accounts[2];

    if !user.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !profile.is_writable() || !user.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }

    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let bump_profile = bump_seed(program_id, &[b"profile", user.key().as_ref()], profile.key())?;
    // init_if_needed: only allocate when the account is empty.
    if profile.data_is_empty() {
        let init_profile_seeds: &[&[u8]] = &[
                b"profile",
                user.key().as_ref(),
                &[bump_profile],
            ];
        let init_profile_signer_seeds = &[&init_profile_seeds[..]];
        create_program_account(profile, user, (8 + VisitProfile::INIT_SPACE) as usize, program_id, init_profile_signer_seeds)?;
        {
            let mut __init_data = unsafe { profile.borrow_mut_data_unchecked() };
            __init_data[..8].copy_from_slice(&VisitProfile::DISCRIMINATOR);
        }
    }
    let clock = pinocchio::sysvars::clock::Clock::get()?;
    let profile_account = profile;
    let mut profile = match VisitProfile::from_account_info(profile_account) {
        Ok(__existing) => __existing,
        Err(_) => VisitProfile {
            user: [0u8; 32],
            visit_count: 0,
            last_visit_ts: 0,
        },
    };
    profile.user = *user.key();
    profile.visit_count = profile.visit_count.checked_add(1).ok_or(VisitError::Overflow)?;
    profile.last_visit_ts = clock.unix_timestamp;
    VisitProfile::save(profile_account, &profile)?;
    Ok(())

}

