//! Event payload structs for EventEmitDemo

//! Generated by Anvil v0.3.0 — Target: Pinocchio

//!

//! Each #[event] from the Anchor source is mirrored as a borsh-derive

//! struct + an 8-byte sha256 discriminator. emit!() handlers serialize

//! via borsh and sol_log_data the result so off-chain indexers see a

//! payload byte-identical to Anchor's macro expansion.


use borsh::{BorshDeserialize, BorshSerialize};

use super::*;

#[derive(BorshSerialize, BorshDeserialize, Debug)]
pub struct Incremented {
    pub new_value: u64,
    pub delta: u64,
}

impl Incremented {
    pub const DISCRIMINATOR: [u8; 8] = [92, 207, 119, 204, 71, 205, 108, 15];
}

=== helpers.rs ===
//! Helper functions for EventEmitDemo

use super::*;
use crate::state::*;
use crate::errors::*;

pub fn bump_seed(
    program_id: &Pubkey,
    seeds: &[&[u8]],
    expected: &Pubkey,
) -> Result<u8, ProgramError> {
    for bump in (0..=255u8).rev() {
        let mut seeds_with_bump: [&[u8]; 16] = [&[]; 16];
        let len = seeds.len().min(15);
        seeds_with_bump[..len].copy_from_slice(&seeds[..len]);
        let bump_slice = &[bump];
        seeds_with_bump[len] = bump_slice;
        if let Ok(derived) = pinocchio::pubkey::create_program_address(&seeds_with_bump[..len + 1], program_id) {
            if &derived == expected {
                return Ok(bump);
            }
        }
    }
    Err(ProgramError::InvalidSeeds)
}

pub fn create_program_account(
    account: &AccountInfo,
    payer: &AccountInfo,
    space: usize,
    program_id: &Pubkey,
    signer_seeds: &[&[&[u8]]],
) -> ProgramResult {
    if signer_seeds.len() > 1 {
        return Err(ProgramError::InvalidSeeds);
    }

    let signer_storage = signer_seeds.first().map(|seed_group| {
        let mut seeds: [Seed<'_>; 8] = core::array::from_fn(|_| Seed::from(&[][..]));
        for (index, seed) in seed_group.iter().enumerate() {
            if index >= seeds.len() {
                return Err(ProgramError::InvalidSeeds);
            }
            seeds[index] = Seed::from(*seed);
        }
        Ok((seeds, seed_group.len()))
    }).transpose()?;

    let signer_slice = if let Some((ref seeds, len)) = signer_storage {
        let signer = Signer::from(&seeds[..len]);
        create_account_with_minimum_balance_signed(account, space, program_id, payer, None, &[signer])
    } else {
        create_account_with_minimum_balance_signed(account, space, program_id, payer, None, &[])
    };

    signer_slice
}

=== instructions/increment.rs ===
use super::*;
use crate::errors::*;

pub fn increment(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 2 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let counter = &accounts[0];
    let authority = &accounts[1];

    if !authority.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !counter.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }
    if counter.owner() != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining = data;
    if remaining.len() < 8 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(8);
    remaining = rest;
    let amount: u64 = u64::from_le_bytes(
        arg_bytes.try_into().map_err(|_| ProgramError::InvalidInstructionData)?
    );
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let _bump_counter = bump_seed(program_id, &[b"evt-counter", authority.key().as_ref()], counter.key())?;
    let counter_account = counter;
    let mut counter = EventCounter::from_account_info(counter_account)?;
    counter.value = counter.value.checked_add(amount).ok_or(EventError::Overflow)?;
    {
        let __evt = Incremented { new_value: counter.value,
            delta: amount, };
        let __evt_bytes = ::borsh::to_vec(&__evt).map_err(|_| ProgramError::InvalidAccountData)?;
        let mut __evt_payload = Incremented::DISCRIMINATOR.to_vec();
        __evt_payload.extend_from_slice(&__evt_bytes);
        pinocchio::log::sol_log_data(&[&__evt_payload]);
    }
    EventCounter::save(counter_account, &counter)?;
    Ok(())

}

=== instructions/initialize.rs ===
use super::*;
use crate::errors::*;

pub fn initialize(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let counter = &accounts[0];
    let authority = &accounts[1];
    let _system_program = &accounts[2];

    if !authority.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !counter.is_writable() || !authority.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }

    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let bump_counter = bump_seed(program_id, &[b"evt-counter", authority.key().as_ref()], counter.key())?;
    let init_counter_seeds: &[&[u8]] = &[
            b"evt-counter",
            authority.key().as_ref(),
            &[bump_counter],
        ];
    let init_counter_signer_seeds = &[&init_counter_seeds[..]];
    create_program_account(counter, authority, (8 + 8 + 1) as usize, program_id, init_counter_signer_seeds)?;
    {
        let mut __init_data = unsafe { counter.borrow_mut_data_unchecked() };
        __init_data[..8].copy_from_slice(&EventCounter::DISCRIMINATOR);
    }
    let counter_account = counter;
    let mut counter = EventCounter { value: 0, bump: 0 };
    counter.value = 0;
    counter.bump = bump_counter;
    EventCounter::save(counter_account, &counter)?;
    Ok(())

}

