//! Error definitions for EventEmitDemo

use super::*;

#[derive(Clone, Copy, Debug, PartialEq)]
#[repr(u32)]
pub enum EventError {
    /// Overflow
    Overflow = 6000,
}

pub use EventError::*;

impl From<EventError> for ProgramError {
    fn from(error: EventError) -> Self {
        ProgramError::Custom(error as u32)
    }
}

