=== instructions/record_min_balance.rs ===
use super::*;

pub fn record_min_balance(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }
    // Capture instruction data before account bindings; an account named
    // "data" would otherwise shadow the parameter and break arg parsing.
    let __ix_data: &[u8] = data;

    let state = &accounts[0];
    let authority = &accounts[1];
    let _system_program = &accounts[2];

    if !authority.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !state.is_writable() || !authority.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }

    if !__ix_data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let bump_state = bump_seed(program_id, &[b"sysvar-rent", authority.key().as_ref()], state.key())?;
    let init_state_seeds: &[&[u8]] = &[
            b"sysvar-rent",
            authority.key().as_ref(),
            &[bump_state],
        ];
    let init_state_signer_seeds = &[&init_state_seeds[..]];
    create_program_account(state, authority, (8 + StateAccount::INIT_SPACE) as usize, program_id, init_state_signer_seeds)?;
    {
        let mut __init_data = unsafe { state.borrow_mut_data_unchecked() };
        __init_data[..8].copy_from_slice(&StateAccount::DISCRIMINATOR);
    }
    let rent = pinocchio::sysvars::rent::Rent::get()?;
    let min_balance = rent.minimum_balance(StateAccount::INIT_SPACE + 8);
    let state_account = state;
    let mut state = StateAccount { min_balance: 0 };
    state.min_balance = min_balance;
    StateAccount::save(state_account, &state)?;
    Ok(())

}

