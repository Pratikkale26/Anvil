=== helpers.rs ===
//! Helper functions for ReallocDemo

use super::*;
use crate::state::*;

pub fn bump_seed(
    program_id: &Pubkey,
    seeds: &[&[u8]],
    expected: &Pubkey,
) -> Result<u8, ProgramError> {
    for bump in (0..=255u8).rev() {
        let mut seeds_with_bump: [&[u8]; 16] = [&[]; 16];
        let len = seeds.len().min(15);
        seeds_with_bump[..len].copy_from_slice(&seeds[..len]);
        let bump_slice = &[bump];
        seeds_with_bump[len] = bump_slice;
        if let Ok(derived) = pinocchio::pubkey::create_program_address(&seeds_with_bump[..len + 1], program_id) {
            if &derived == expected {
                return Ok(bump);
            }
        }
    }
    Err(ProgramError::InvalidSeeds)
}

pub fn create_program_account(
    account: &AccountInfo,
    payer: &AccountInfo,
    space: usize,
    program_id: &Pubkey,
    signer_seeds: &[&[&[u8]]],
) -> ProgramResult {
    if signer_seeds.len() > 1 {
        return Err(ProgramError::InvalidSeeds);
    }

    let signer_storage = signer_seeds.first().map(|seed_group| {
        let mut seeds: [Seed<'_>; 8] = core::array::from_fn(|_| Seed::from(&[][..]));
        for (index, seed) in seed_group.iter().enumerate() {
            if index >= seeds.len() {
                return Err(ProgramError::InvalidSeeds);
            }
            seeds[index] = Seed::from(*seed);
        }
        Ok((seeds, seed_group.len()))
    }).transpose()?;

    let signer_slice = if let Some((ref seeds, len)) = signer_storage {
        let signer = Signer::from(&seeds[..len]);
        create_account_with_minimum_balance_signed(account, space, program_id, payer, None, &[signer])
    } else {
        create_account_with_minimum_balance_signed(account, space, program_id, payer, None, &[])
    };

    signer_slice
}

=== instructions/append.rs ===
use super::*;

pub fn append(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let state = &accounts[0];
    let owner = &accounts[1];
    let _system_program = &accounts[2];

    if !owner.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !state.is_writable() || !owner.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }
    if state.owner() != program_id {
        return Err(ProgramError::IncorrectProgramId);
    }

    // Args
    let mut remaining = data;
    if remaining.len() < 1 {
        return Err(ProgramError::InvalidInstructionData);
    }
    let (arg_bytes, rest) = remaining.split_at(1);
    remaining = rest;
    let byte: u8 = arg_bytes[0];
    if !remaining.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    // realloc — resize state to 8 + 1 + 4 + state.log.len() + 1
    {
        let __state_for_realloc = LogState::from_account_info(state)?;
        let __new_size = (8 + 1 + 4 + __state_for_realloc.log.len() + 1) as usize;
        let __rent = pinocchio::sysvars::rent::Rent::get()?;
        let __new_lamports = Rent::get()?.minimum_balance(__new_size);
        let __delta = __new_lamports.saturating_sub(state.lamports());
        if __delta > 0 {
            pinocchio_system::instructions::Transfer {
                from: owner,
                to: state,
                lamports: __delta,
            }.invoke()?;
        }
        state.realloc(__new_size, false)?;
    }
    let _bump_state = bump_seed(program_id, &[b"realloc-st", owner.key().as_ref()], state.key())?;
    let mut s = LogState::from_account_info(state)?;
    s.log.push(byte);
    LogState::save(state, &s)?;
    Ok(())

}

=== instructions/init.rs ===
use super::*;

pub fn init(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    data: &[u8],
) -> ProgramResult {
    if accounts.len() < 3 {
        return Err(ProgramError::NotEnoughAccountKeys);
    }

    let state = &accounts[0];
    let owner = &accounts[1];
    let _system_program = &accounts[2];

    if !owner.is_signer() {
        return Err(ProgramError::MissingRequiredSignature);
    }
    if !state.is_writable() || !owner.is_writable() {
        return Err(ProgramError::InvalidAccountData);
    }

    if !data.is_empty() {
        return Err(ProgramError::InvalidInstructionData);
    }

    let bump_state = bump_seed(program_id, &[b"realloc-st", owner.key().as_ref()], state.key())?;
    let init_state_seeds: &[&[u8]] = &[
            b"realloc-st",
            owner.key().as_ref(),
            &[bump_state],
        ];
    let init_state_signer_seeds = &[&init_state_seeds[..]];
    create_program_account(state, owner, (8 + 1 + 4) as usize, program_id, init_state_signer_seeds)?;
    {
        let mut __init_data = unsafe { state.borrow_mut_data_unchecked() };
        __init_data[..8].copy_from_slice(&LogState::DISCRIMINATOR);
    }
    let mut s = LogState {
        bump: 0,
        log: Vec::new(),
    };
    s.bump = bump_state;
    s.log = vec![];
    LogState::save(state, &s)?;
    Ok(())

}

