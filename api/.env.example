PORT=8080
# Comma-separated list. Production must include BOTH the apex domain and
# the www subdomain — Vercel's default behavior redirects apex → www, so
# the browser's eventual Origin header is https://www.anvilsol.xyz, not
# the apex. Missing the www variant = browser CORS blocks every fetch =
# frontend shows "API offline" even though the API is up.
CORS_ORIGIN=http://localhost:3000,https://anvilsol.xyz,https://www.anvilsol.xyz
RATE_LIMIT=60
ANTHROPIC_API_KEY=sk-ant-...
AI_PROVIDER=anthropic
AI_REPAIR_MODEL=claude-sonnet-4-6
ANVIL_SANDBOX=firejail
ANVIL_DAILY_AI_USD_PER_IP=2
ANVIL_DATA_DIR=/home/pk/.anvil-data
ANVIL_BUILD_TIMEOUT_MS=60000
SENTRY_DSN=