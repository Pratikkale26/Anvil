{
  "name": "api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "verify-compiler": "bun verify-compiler.ts",
    "verify-parser": "bun verify-parser.ts",
    "test": "bun test tests/",
    "test:parser": "bun test tests/parser-snapshots.test.ts",
    "test:emitter": "bun test tests/emitter-validation.test.ts",
    "test:api": "bun test tests/api.test.ts",
    "test:snapshots": "bun test tests/emitter-snapshots.test.ts",
    "test:cargo": "bun test tests/cargo-build.test.ts --timeout 600000",
    "test:all": "bun test tests/",
    "test:update-snapshots": "find tests/snapshots/emitter-output -maxdepth 1 -name '*.rs' -not -name '*.actual.rs' -delete && bun test tests/emitter-snapshots.test.ts",
    "test:check-clean": "bun scripts/check-clean-snapshots.ts"
  },
  "devDependencies": {
    "@noble/hashes": "^2.2.0",
    "@solana/spl-token": "^0.4.14",
    "@types/bun": "^1.3.13",
    "@types/cors": "^2.8.19"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@sentry/node": "^10.52.0",
    "@solana/web3.js": "^1.98.4",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "litesvm": "0.7.0",
    "tree-sitter-rust": "^0.24.0",
    "web-tree-sitter": "^0.26.8",
    "zod": "^4.4.3"
  }
}
