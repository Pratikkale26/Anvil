          "bumpField": "&[listing.bump]",
          "rawCode": "let seeds = &[\n            b\"listing\",\n            listing.seller.as_ref(),\n            &listing.seed.to_le_bytes(),\n            &[listing.bump],\n        ];\nlet signer_seeds = &[&seeds[..]];"
        },
        {
          "kind": "cpi_spl_transfer",
          "from": "vault",
          "to": "seller_ata",
          "authority": "listing",
          "amount": "1",
          "signerSeeds": "signer_seeds"
        },
        {
          "kind": "cpi_spl_close_account",
          "account": "vault",
          "destination": "seller",
          "authority": "listing",
          "signerSeeds": "signer_seeds"
        },
        {
          "kind": "state_read",
          "account": "marketplace",
          "localVar": "marketplace",
          "mutable": true,
          "accountType": "Marketplace"
        },
