      "name": "vested_amount",
      "signature": "fn vested_amount(\n    total: u64,\n    start_ts: i64,\n    cliff_ts: i64,\n    end_ts: i64,\n    now: i64,\n) -> u64",
      "body": "{\n    if now < cliff_ts {\n        return 0;\n    }\n    if now >= end_ts {\n        return total;\n    }\n    let elapsed = (now - start_ts) as u64;\n    let duration = (end_ts - start_ts) as u64;\n    total\n        .checked_mul(elapsed)\n        .and_then(|v| v.checked_div(duration))\n        .unwrap_or(0)\n}",
      "isPublic": false,
      "rawCode": "fn vested_amount(\n    total: u64,\n    start_ts: i64,\n    cliff_ts: i64,\n    end_ts: i64,\n    now: i64,\n) -> u64 {\n    if now < cliff_ts {\n        return 0;\n    }\n    if now >= end_ts {\n        return total;\n    }\n    let elapsed = (now - start_ts) as u64;\n    let duration = (end_ts - start_ts) as u64;\n    total\n        .checked_mul(elapsed)\n        .and_then(|v| v.checked_div(duration))\n        .unwrap_or(0)\n}"
    }
